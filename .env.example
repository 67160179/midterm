# พอร์ตที่ Express server จะรัน (ตรงกับ process.env.PORT ใน server.js)
PORT=3000

# บอก environment ปัจจุบันของแอป — ใช้แสดงผลใน log ตอน server เริ่มทำงาน
# (และมักถูกไลบรารีอื่นๆ เช่น express ใช้ปรับพฤติกรรมบางอย่างอัตโนมัติ เช่น error message ที่ละเอียดขึ้นตอน development)
NODE_ENV=development

# origin เดียวที่อนุญาตให้เรียก API นี้ผ่าน CORS ได้ (ใช้ใน cors({ origin: process.env.ALLOWED_ORIGIN }) ใน server.js)
# ต้องเปลี่ยนเป็น domain จริงของ frontend เวลา deploy ขึ้น production
ALLOWED_ORIGIN=http://localhost:3001

# ----- ค่าการเชื่อมต่อฐานข้อมูล MySQL (ใช้ใน db.js ตอนสร้าง connection pool) -----
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=student_api

# ----- ค่าสำหรับระบบ JWT (ใช้ใน auth-helpers.js ตอนเซ็น token) -----

# secret key ที่ใช้เซ็นลายเซ็นของ JWT ทุกใบที่ออกให้ผู้ใช้
# ค่าที่ใส่ไว้นี้เป็นแค่ placeholder เตือนให้เปลี่ยน ห้ามใช้ค่านี้จริงเด็ดขาดตอน deploy
# ควรสุ่มเป็น string ยาวๆ แบบสุ่มจริง (เช่นด้วย crypto.randomBytes) เพราะถ้า secret หลุดหรือเดาง่าย
# คนร้ายจะสามารถปลอม token เป็น role admin แล้วเข้าถึง route ที่ authorizeRole("admin") ป้องกันไว้ได้ทันที
JWT_SECRET=change-this-to-a-long-random-string-in-production

# อายุของ token แต่ละใบ หลังจากเวลานี้ผ่านไป jwt.verify จะ throw error และผู้ใช้ต้อง login ใหม่
JWT_EXPIRES_IN=1h